{
  "name": "turmas-epf/turmas-bridge",
  "description": "Plugin WordPress de ponte autenticada para TURMAS-EPF.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "lint": "@php tools/lint.php",
    "typecheck": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
